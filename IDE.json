{
  "workbench.colorCustomizations": {
    "terminal.background": "#0a0e1400",
    "terminal.foreground": "#E8DFE1",
    "terminalCursor.foreground": "#C21F36",
    "terminal.selectionBackground": "#C21F366b",
    "terminal.ansiBlack": "#393237",
    "terminal.ansiRed": "#C21F36",
    "terminal.ansiBrightRed": "#FF334A",
    "terminal.ansiWhite": "#E8DFE1",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono Nerd Font Mono', 'Cascadia Code NF', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.letterSpacing": 0.2,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.minimumContrastRatio": 7,
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
